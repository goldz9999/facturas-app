{
  "name": "facturas-backend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
