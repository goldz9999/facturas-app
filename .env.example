PORT=3000

# --- Supabase ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_KEY=TU-SERVICE-ROLE-KEY

# --- Auth ---
# Obligatoria: sin ella el backend no arranca. Genera una con:
#   openssl rand -hex 48
JWT_SECRET=

# --- CORS: dominio(s) del frontend, separados por coma, sin barra final ---
# Sin esto el backend rechaza todo tráfico del navegador salvo localhost.
FRONTEND_URL=https://app.tudominio.com

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Debe coincidir con el secret_token usado en setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Solo si activas Caddy (docker compose --profile proxy up -d) ---
# Dominio público de la API; su registro DNS (A) debe apuntar a la IP del VPS.
# API_DOMAIN=api.tudominio.com