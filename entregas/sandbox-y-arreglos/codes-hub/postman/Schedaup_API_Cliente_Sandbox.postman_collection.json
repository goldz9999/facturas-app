      "name": "1 Completada",
      "item": [
        {
          "name": "1a. Validar 100001",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const v = pm.response.json();",
                  "if (v.validation_id) pm.collectionVariables.set('validation_id', v.validation_id);",
                  "console.log('Jugador:', v.user_name);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/topups/validate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "topups",
                "validate"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_sku\": \"{{topup_sku}}\",\n  \"account\": {\n    \"user_id\": \"100001\",\n    \"zone_id\": \"1\",\n    \"server\": \"1\"\n  }\n}"
            }
          }
        },
        {
          "name": "1b. Recargar → completed",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('topup_request_id', 'sandbox-' + pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status = completed', () => pm.expect(pm.response.json().status).to.eql('completed'));"
                ]
              }
            }
          ],
          "request": {
